    {
      "id": "customer-support-flow",
      "number": 5,
      "title": "Customer Support Flow",
      "type": "Flow",
      "pattern": "Router",
      "cacheable": true,
      "inputs": [
        {
          "key": "ticket_text",
          "label": "Support ticket",
          "type": "text",
          "required": true,
          "minLength": 10,
          "maxLength": 4000,
          "multiline": true
        }
      ],
      "nodes": [
        {
          "nodeId": "receive_ticket",
          "kind": "input",
          "name": "receive_ticket",
          "tag": "@start()",
          "detail": "Fills the ticket state"
        },
        {
          "nodeId": "categorize_ticket",
          "kind": "step",
          "name": "categorize_ticket",
          "tag": "@listen(receive_ticket)",
          "detail": "Direct LLM call"
        },
        {
          "nodeId": "route_by_category",
          "kind": "router",
          "name": "route_by_category",
          "tag": "@router",
          "detail": "Returns a label"
        },
        {
          "nodeId": "handle_billing",
          "kind": "step",
          "name": "handle_billing",
          "tag": "@listen(\"billing\")",
          "detail": "priority = high"
        },
        {
          "nodeId": "handle_access",
          "kind": "step",
          "name": "handle_access",
          "tag": "@listen(\"account_access\")",
          "detail": "priority = high"
        },
        {
          "nodeId": "handle_other",
          "kind": "dashed",
          "name": "handle_other",
          "tag": "@listen(\"other\")",
          "detail": "technical, feature"
        },
        {
          "nodeId": "or_",
          "kind": "join",
          "name": "or_"
        },
        {
          "nodeId": "resolve_ticket",
          "kind": "output",
          "name": "resolve_ticket",
          "tag": "@listen(or_)",
          "detail": "Returns resolution"
        }
      ]
    },
