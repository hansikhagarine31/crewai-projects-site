# Copy to .env. Never commit .env.
PORT=8000
CORS_ORIGIN=http://localhost:5173
AGENTS_URL=http://127.0.0.1:8001
# Must equal AGENT_SHARED_SECRET in agents/.env
AGENT_SHARED_SECRET=change-me

# Optional tuning (values shown are the defaults)
# TRUST_PROXY=false            # set to the number of proxies in front of the server, if any
# RATE_LIMIT_RUNS=5            # runs per address per window
# RATE_LIMIT_WINDOW_MS=3600000
# MAX_CONCURRENT_RUNS=3
# AGENT_TIMEOUT_MS=300000
# RUN_TTL_MS=1800000           # how long finished runs are kept
# AWAITING_UPLOAD_TTL_MS=600000
# MAX_EVENTS_PER_RUN=500
# MAX_OUTPUT_BYTES=5242880
# UPLOAD_MAX_BYTES=2097152
# CACHE_TTL_MS=3600000
# CACHE_MAX_ENTRIES=100
# CACHE_REPLAY_DELAY_MS=150
# SSE_HEARTBEAT_MS=15000
# JSON_LIMIT=100kb
