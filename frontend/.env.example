# Read when the site is built (npm run build). The value is public: it ends up in the browser bundle.
# Leave empty in development: Vite then proxies /api to http://localhost:8000.
# In production, the address of the server service, without a trailing slash, for example:
# VITE_API_BASE_URL=https://crewai-server.onrender.com
VITE_API_BASE_URL=
